# ── Database (Local Dev) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=learnflow

# ── Firebase ───────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS=config/serviceAccountKey.json


# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_DEBUG=false
FLASK_PORT=5000
SECRET_KEY=your_secret_key_here

CORS_ORIGINS=*
